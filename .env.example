APP_ENV=production
RUNTIME_MODE=live
DATABASE_URL=sqlite:///./data/production.db
# Optional explicit pack directory. Blank uses packs bundled in the installed wheel.
PACKS_ROOT=

# Required for operator access when APP_ENV=production. Use HTTPS at your proxy.
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD=
# Sign normalized webhook JSON with HMAC-SHA256; see docs/production.md.
WEBHOOK_SECRET=
WEBHOOK_MAX_BYTES=1048576
WORKER_POLL_SECONDS=5
MAX_EVENT_ATTEMPTS=5
MAX_DELIVERY_ATTEMPTS=5
RETRY_BASE_SECONDS=5
QUEUE_LEASE_SECONDS=300

# Only live modes enable operations. Other modes fail explicitly.
CLAUDE_MODE=live
ANTHROPIC_API_KEY=
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
HUBSPOT_MODE=live
MAIL_MODE=live
FIREFLIES_MODE=live
ESIGN_MODE=live

CLAUDE_MODEL_RESEARCH=
CLAUDE_MODEL_OUTREACH=
CLAUDE_MODEL_TRIAGE=
CLAUDE_MODEL_CALL_INTELLIGENCE=
CLAUDE_MODEL_DEAL_DESK=

HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_SEGMENT_PROPERTY=ars_segment
HUBSPOT_FIT_PROPERTY=ars_fit
HUBSPOT_INTENT_PROPERTY=ars_intent
HUBSPOT_SCORE_PROPERTY=ars_score
HUBSPOT_STAGE_PROPERTY=ars_stage
# Create output properties before enabling property-level CRM write-back.
CRM_SYNC_ENABLED=false
# Canonical external base URL; native HubSpot signatures include this exact URL.
PUBLIC_WEBHOOK_URL=
RESEND_WEBHOOK_SECRET=
FIREFLIES_WEBHOOK_SECRET=
MAIL_REPLY_DOMAIN=
MAIL_THREAD_SECRET=
MAIL_API_KEY=
MAIL_FROM_ADDRESS=
FIREFLIES_API_KEY=
ESIGN_API_KEY=
ESIGN_BASE_URL=https://api.hellosign.com
# Signer comes from the reviewed deal; exact DOCX is uploaded, not a shared URL.
ESIGN_ALLOWED_RECIPIENTS=
ESIGN_TEST_MODE=true
LIVE_SIDE_EFFECTS_ENABLED=false
MAIL_ALLOWED_RECIPIENTS=

